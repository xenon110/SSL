# -------------------------------------------------------------
# Supabase Configuration for Next.js
# -------------------------------------------------------------
# 1. Go to your Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your Project
# 3. Go to Project Settings (Gear Icon in bottom left) -> API

# Your Project URL (e.g. https://xyz.supabase.co)
NEXT_PUBLIC_SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL_HERE"

# Your anon public API Key (Safe to expose to the frontend)
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY_HERE"
