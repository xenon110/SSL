# -------------------------------------------------------------
# Supabase Configuration
# -------------------------------------------------------------
# 1. Go to your Supabase Dashboard: https://supabase.com/dashboard
# 2. Select your Project
# 3. Go to Project Settings (Gear Icon in bottom left) -> API

# Your Project URL (e.g. https://xyz.supabase.co)
SUPABASE_URL="YOUR_SUPABASE_PROJECT_URL_HERE"

# Your SERVICE_ROLE Secret Key (DO NOT expose this to the frontend)
# Used by the backend to bypass Row Level Security when importing Tally data
SUPABASE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"
